# ==============================================================================
# Microsoft Intune Visual Doc (.env)
# Copy this file to .env and configure your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Microsoft Entra ID / Microsoft Intune Service Principal (SPN)
# Required for unattended extraction, backups, posture audits, and drift diffs.
# Must have read-only Graph roles (e.g. DeviceManagementConfiguration.Read.All).
# ------------------------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-spn-client-secret-here

# Optional: Alternative variable names also recognized
# INTUNE_TENANT_ID=
# INTUNE_CLIENT_ID=
# INTUNE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Storage Directory Overrides (Optional)
# ------------------------------------------------------------------------------
# INTUNEDOC_OUTPUT_DIR=deliverables
# INTUNEDOC_AUTH_DIR=.auth
