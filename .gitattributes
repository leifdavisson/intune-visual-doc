# Set default behaviour to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and not converted to CRLF on checkout.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.jinja2 text eol=lf
